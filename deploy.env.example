# Скопируйте в deploy.env или .env.deploy и подставьте свои значения.
# Файлы deploy.env и .env.deploy не коммитятся (.gitignore).

# Обязательно: пользователь и хост SSH на Beget (как в панели хостинга)
DEPLOY_SSH=mantoos7_1@mantoos7.beget.tech

# Каталог сайта на сервере (куда распаковывается архив; на Beget обычно ~/имя_домена/public_html)
DEPLOY_REMOTE_DIR=~/mantoos7.beget.tech/public_html

# При необходимости переопределите путь к архиву на сервере после scp (по умолчанию ~/имя_архива)
# DEPLOY_REMOTE_ARCHIVE=~/gymacro-deploy.tgz

# Имя локального и удалённого архива (по умолчанию gymacro-deploy.tgz)
# DEPLOY_ARCHIVE_NAME=gymacro-deploy.tgz
