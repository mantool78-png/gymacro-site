{
  "name": "gymacro-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build && node scripts/prepare-standalone.js",
    "deploy:pack": "npm run build && tar -caf gymacro-deploy.tgz server.js package.json .htaccess .next/standalone",
    "deploy:upload": "scp \"D:/fedor/Documents/gymacro-site/gymacro-deploy.tgz\" mantoos7_1@mantoos7.beget.tech:~/",
    "deploy:remote": "ssh mantoos7_1@mantoos7.beget.tech \"tar -xzf ~/gymacro-deploy.tgz -C ~/mantoos7.beget.tech/public_html && mkdir -p ~/mantoos7.beget.tech/public_html/tmp && touch ~/mantoos7.beget.tech/public_html/tmp/restart.txt\"",
    "deploy:beget": "npm run deploy:pack && npm run deploy:upload && npm run deploy:remote",
    "start": "node server.js",
    "lint": "eslint",
    "analyze": "cross-env ANALYZE=true next build"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@next/bundle-analyzer": "^16.2.2",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
