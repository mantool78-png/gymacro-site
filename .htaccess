# gymacro.ru — Beget: Apache + Phusion Passenger (Node / Next.js standalone)
# После заливки: touch tmp/restart.txt — перезапуск Passenger (не запускать второй раз node вручную)

RewriteEngine On

# Канонический хост: один вариант сайта — без www (совпадает с getSiteUrl / metadata)
RewriteCond %{HTTP_HOST} ^www\.gymacro\.ru$ [NC]
RewriteRule ^ https://gymacro.ru%{REQUEST_URI} [L,R=301]

# Старый кириллический slug статьи о средней в тройке → латинский canonical
RewriteRule ^posts/%D1%80%D0%BE%D0%BB%D1%8C-%D1%81%D1%80%D0%B5%D0%B4%D0%BD%D0%B5%D0%B9-%D0%B2-%D1%81%D0%BF%D0%BE%D1%80%D1%82%D0%B8%D0%B2%D0%BD%D0%BE%D0%B9-%D0%B0%D0%BA%D1%80%D0%BE%D0%B1%D0%B0%D1%82%D0%B8%D0%BA%D0%B5/?$ /posts/rol-srednej-v-sportivnoj-akrobatike-nezametnyj-geroj-trojki [L,R=301,NE]

# Папка CMS — не отдавать в Next
RewriteRule ^cms($|/) - [L]

# WordPress — не отдавать в Next
RewriteCond %{REQUEST_URI} ^/wp-admin
RewriteRule ^ - [L]

RewriteCond %{REQUEST_URI} ^/wp-login\.php
RewriteRule ^ - [L]

RewriteCond %{REQUEST_URI} ^/wp-json
RewriteRule ^ - [L]

RewriteCond %{REQUEST_URI} ^/wp-content
RewriteRule ^ - [L]

RewriteCond %{REQUEST_URI} ^/wp-includes
RewriteRule ^ - [L]

RewriteCond %{REQUEST_URI} ^/xmlrpc\.php
RewriteRule ^ - [L]

RewriteCond %{REQUEST_URI} \.php$
RewriteRule ^ - [L]

# Passenger — без PassengerEnvVar (на Beget в .htaccess часто даёт 500)
PassengerNodejs /home/m/mantoos7/mantoos7.beget.tech/public_html/node
PassengerAppRoot /home/m/mantoos7/mantoos7.beget.tech/public_html
PassengerFriendlyErrorPages on
PassengerAppType node
PassengerStartupFile server.js
